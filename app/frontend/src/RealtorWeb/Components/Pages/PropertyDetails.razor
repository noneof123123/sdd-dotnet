@page "/properties/{id:guid}"
@rendermode InteractiveServer
@using PropertyState = RealtorWeb.Features.Properties.PresentationState
@inject IPropertyCatalogService CatalogService
@inject InteractionContext Interaction

<PageTitle>Detalle de la propiedad</PageTitle>

<section class="details-section" aria-labelledby="detalle-titulo">
    <a class="back-link" href="@Model.BackUrl">
        <LucideIcon Name="arrow-left" ClassName="icon icon-sm" aria-hidden="true" />
        Volver al catálogo
    </a>

    <h1 id="detalle-titulo" class="@HeadingCssClass">@Heading</h1>

    @if (Model.State == PropertyState.Contenido)
    {
        <header class="details-header">
            <div>
                <p class="eyebrow">Ficha de la propiedad</p>
                <p class="details-address">@Model.Address</p>
                <PropertyStatusBadge Label="@Model.StatusLabel" />
            </div>
            <p class="details-price">@Model.Price</p>
        </header>

        <div class="details-layout">
            <div class="details-media">
                @if (string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="image-placeholder" role="img" aria-label="@Model.ImageAlt">
                        <LucideIcon Name="image" ClassName="icon icon-xl" aria-hidden="true" />
                        <span>@Model.ImageAlt</span>
                    </div>
                }
                else
                {
                    <img src="@Model.ImageUrl" alt="@Model.ImageAlt" loading="lazy" />
                }
            </div>

            <div class="details-body">
                <p class="details-description">@Model.Description</p>

                <dl class="details-facts">
                    <div>
                        <dt>Dormitorios</dt>
                        <dd>@Model.BedroomCount dormitorios</dd>
                    </div>
                    <div>
                        <dt>Baños</dt>
                        <dd>@Model.BathroomCount baños</dd>
                    </div>
                    <div>
                        <dt>Superficie</dt>
                        <dd>@Model.AreaSquareMeters m²</dd>
                    </div>
                </dl>

                <dl class="details-dates">
                    <div>
                        <dt>Creación</dt>
                        <dd>@Model.CreatedAt</dd>
                    </div>
                    <div>
                        <dt>Última actualización</dt>
                        <dd>@Model.UpdatedAt</dd>
                    </div>
                </dl>
            </div>
        </div>
    }
    else
    {
        <PresentationState State="@Model.State" Message="@Model.Message" RetryUrl="@Model.RetryUrl" OnRetry="ReintentarAsync" />
    }
</section>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    private PropertyDetailsViewModel Model { get; set; } = LoadingModel(Guid.Empty, 1);

    private string _claveCargada = string.Empty;

    private int _intencion;

    private string Heading => Model.State == PropertyState.Contenido
        ? Model.Title
        : "Detalle de la propiedad";

    private string HeadingCssClass => Model.State == PropertyState.Contenido
        ? string.Empty
        : "sr-only";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var pagina = CatalogNavigation.SanitizePage(Page);
        var clave = Clave(Id, pagina);
        if (string.Equals(_claveCargada, clave, StringComparison.Ordinal))
        {
            return;
        }

        await CargarAsync(pagina, clave);
    }

    private async Task ReintentarAsync()
    {
        _claveCargada = string.Empty;
        await CargarAsync(CatalogNavigation.SanitizePage(Page));
    }

    private async Task CargarAsync(int pagina, string? clave = null)
    {
        var intencion = ++_intencion;
        _claveCargada = clave ?? Clave(Id, pagina);
        Interaction.RegistrarDetalle(Id, pagina, CatalogNavigation.BackUrl(pagina));
        Interaction.ComenzarEspera();
        Model = LoadingModel(Id, pagina);
        StateHasChanged();

        try
        {
            var resultado = await CatalogService.GetDetailsAsync(Id, pagina, CancellationToken.None);
            if (intencion != _intencion)
            {
                return;
            }

            Model = resultado;
            if (resultado.State == PropertyState.Error)
            {
                Interaction.CompletarNoDisponible();
            }
            else
            {
                Interaction.CompletarCorrecto(Interaction.UltimoResultado == InteractionOutcome.Lento);
            }
        }
        catch (Exception)
        {
            if (intencion != _intencion)
            {
                return;
            }

            Model = ErrorModel(Id, pagina);
            Interaction.CompletarNoDisponible();
        }
        finally
        {
            if (intencion == _intencion)
            {
                StateHasChanged();
            }
        }
    }

    private static string Clave(Guid id, int pagina) =>
        $"{id.ToString("D", System.Globalization.CultureInfo.InvariantCulture)}|{pagina.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static PropertyDetailsViewModel LoadingModel(Guid id, int pagina) => new(
        id,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        0,
        0,
        0,
        null,
        string.Empty,
        string.Empty,
        string.Empty,
        CatalogNavigation.BackUrl(pagina),
        PropertyState.Cargando,
        InteractionMessages.EsperandoDetalle,
        null);

    private static PropertyDetailsViewModel ErrorModel(Guid id, int pagina) => new(
        id,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        0,
        0,
        0,
        null,
        string.Empty,
        string.Empty,
        string.Empty,
        CatalogNavigation.BackUrl(pagina),
        PropertyState.Error,
        PropertyPresentation.MessageFor(PropertyState.Error, true),
        CatalogNavigation.RetryDetailsUrl(id, pagina));
}
