@page "/"
@rendermode InteractiveServer
@using PropertyState = RealtorWeb.Features.Properties.PresentationState
@inject IPropertyCatalogService CatalogService
@inject InteractionContext Interaction

<PageTitle>Catálogo de propiedades</PageTitle>

<section class="catalog-section" aria-labelledby="catalogo-titulo">
    <header class="section-header">
        <p class="eyebrow">Realtor</p>
        <h1 id="catalogo-titulo">Catálogo de propiedades</h1>
        <p class="section-subtitle">Descubre inmuebles disponibles para tu próximo hogar.</p>
    </header>

    @if (Model.State == PropertyState.Contenido)
    {
        <p class="catalog-summary" role="status">@Model.SummaryText · @Model.TotalItemsText</p>

        <div class="property-grid">
            @foreach (var item in Model.Items)
            {
                <PropertyCard Property="@item" />
            }
        </div>

        <nav class="pagination" aria-label="@PropertyPresentation.PaginationNavLabel">
            @if (Model.HasPrevious && Model.PreviousUrl is { Length: > 0 } previousUrl)
            {
                <a class="button-link button-link--secondary" href="@previousUrl">@PropertyPresentation.PreviousControlText</a>
            }
            else
            {
                <span class="button-link button-link--secondary button-link--disabled" role="link" aria-disabled="true" aria-label="@PropertyPresentation.PreviousDisabledLabel">@PropertyPresentation.PreviousControlText</span>
            }

            <span class="pagination__label" aria-current="page">@Model.SummaryText</span>

            @if (Model.HasNext && Model.NextUrl is { Length: > 0 } nextUrl)
            {
                <a class="button-link" href="@nextUrl">@PropertyPresentation.NextControlText</a>
            }
            else
            {
                <span class="button-link button-link--disabled" role="link" aria-disabled="true" aria-label="@PropertyPresentation.NextDisabledLabel">@PropertyPresentation.NextControlText</span>
            }
        </nav>
    }
    else
    {
        <PresentationState State="@Model.State" Message="@Model.Message" RetryUrl="@Model.RetryUrl" OnRetry="ReintentarAsync" />
    }
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    private PropertyCatalogViewModel Model { get; set; } = LoadingModel(1);

    private string _claveCargada = string.Empty;

    private int _intencion;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var pagina = CatalogNavigation.SanitizePage(Page);
        var clave = Clave(pagina);
        if (string.Equals(_claveCargada, clave, StringComparison.Ordinal))
        {
            return;
        }

        await CargarAsync(pagina, clave);
    }

    private async Task ReintentarAsync()
    {
        _claveCargada = string.Empty;
        await CargarAsync(CatalogNavigation.SanitizePage(Page));
    }

    private async Task CargarAsync(int pagina, string? clave = null)
    {
        var intencion = ++_intencion;
        _claveCargada = clave ?? Clave(pagina);
        Interaction.RegistrarCatalogo(Page, CatalogNavigation.CatalogUrl(pagina));
        Interaction.ComenzarEspera();
        Model = LoadingModel(pagina);
        StateHasChanged();

        try
        {
            var resultado = await CatalogService.GetCatalogAsync(pagina, CancellationToken.None);
            if (intencion != _intencion)
            {
                return;
            }

            Model = resultado;
            if (resultado.State == PropertyState.Error)
            {
                Interaction.CompletarNoDisponible();
            }
            else
            {
                Interaction.CompletarCorrecto(Interaction.UltimoResultado == InteractionOutcome.Lento);
            }
        }
        catch (Exception)
        {
            if (intencion != _intencion)
            {
                return;
            }

            Model = ErrorModel(pagina);
            Interaction.CompletarNoDisponible();
        }
        finally
        {
            if (intencion == _intencion)
            {
                StateHasChanged();
            }
        }
    }

    private static string Clave(int pagina) =>
        pagina.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static PropertyCatalogViewModel LoadingModel(int pagina) => new(
        Array.Empty<PropertyCardViewModel>(),
        pagina,
        CatalogNavigation.PageSize,
        0,
        1,
        false,
        false,
        null,
        null,
        string.Empty,
        PropertyState.Cargando,
        InteractionMessages.EsperandoCatalogo,
        null);

    private static PropertyCatalogViewModel ErrorModel(int pagina) => new(
        Array.Empty<PropertyCardViewModel>(),
        pagina,
        CatalogNavigation.PageSize,
        0,
        1,
        false,
        false,
        null,
        null,
        string.Empty,
        PropertyState.Error,
        PropertyPresentation.MessageFor(PropertyState.Error),
        CatalogNavigation.RetryCatalogUrl(pagina));
}
