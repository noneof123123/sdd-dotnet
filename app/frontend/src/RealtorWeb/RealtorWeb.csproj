<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LucideBlazor" Version="1.0.7" />
    <PackageReference Include="Refit" Version="17.0.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="17.0.0" />
    <PackageReference Include="Refit.HttpClientFactory.Reflection" Version="17.0.0" />
  </ItemGroup>

</Project>
